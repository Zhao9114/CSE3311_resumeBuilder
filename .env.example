# Copy to .env.local (gitignored) and fill in from
# Supabase dashboard → Project Settings → API.
#
# Leave both blank to run in demo mode on in-memory data with no login.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon / publishable key ONLY. It is public by design; row-level
# security protects the data. Never put the service_role / secret key here —
# anything prefixed VITE_ is bundled into the browser.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
