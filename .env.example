# Copy to .env.local (gitignored) and fill in from
# Supabase dashboard → Project Settings → API.
#
# Leave both blank to run in demo mode on in-memory data with no login.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon / publishable key ONLY. It is public by design; row-level
# security protects the data. Never put the service_role / secret key here —
# anything prefixed VITE_ is bundled into the browser.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ── Server-only (iteration 3 AI) ─────────────────────────────────────────────
# No VITE_ prefix: these are read by the serverless functions in api/ (and by
# the dev server for `npm run dev`) and never reach the browser. On Vercel,
# set them in Project Settings → Environment Variables.

# Anthropic API key. Leave blank to switch the AI features off — the ATS check
# and the Assistant then show sample output. Revoke it in the Anthropic Console
# when the demos are over.
ANTHROPIC_API_KEY=

# Service-role key, from Supabase → Project Settings → API. Lets the functions
# keep the AI usage ledger (rate limits + spend cap) in the ai_usage table.
# Without it, limits are kept in memory per function instance — fine locally,
# not in production. NEVER prefix this with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Any random string. Anonymous callers are rate-limited by a salted hash of
# their IP; the raw address is never stored.
IP_HASH_SALT=

# Spend cap in USD across all AI calls (default 4, under a $5 Console limit),
# and per-caller limits (defaults shown).
# AI_BUDGET_USD=4
# AI_DAILY_LIMIT_USER=40
# AI_MINUTE_LIMIT_USER=6
# AI_DAILY_LIMIT_ANON=15
# AI_MINUTE_LIMIT_ANON=4
